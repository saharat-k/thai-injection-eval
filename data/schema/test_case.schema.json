{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/saharat-k/thai-injection-eval/main/data/schema/test_case.schema.json",
  "title": "ThaiInjectionTestCase",
  "description": "Canonical JSON schema for prompt injection evaluation test cases in Thai and Code-Mixed LLM interactions.",
  "type": "object",
  "required": [
    "id",
    "category",
    "technique",
    "language",
    "difficulty",
    "is_benign",
    "prompt",
    "expected_behavior",
    "evaluation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the test case (e.g., PI-TH-001, TH-1, PAR-01-TH, LING-CS-01-V1).",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "owasp_category": {
      "type": "string",
      "description": "OWASP Top 10 for LLMs mapping.",
      "enum": [
        "OWASP-LLM01:Prompt-Injection",
        "OWASP-LLM02:Sensitive-Information-Disclosure",
        "OWASP-LLM06:Excessive-Agency",
        "BENIGN:Control-Baseline"
      ]
    },
    "category": {
      "type": "string",
      "description": "Macro attack or evaluation classification per project taxonomy.",
      "enum": [
        "direct_injection",
        "indirect_injection",
        "linguistic_evasion",
        "sensitive_information_disclosure",
        "excessive_agency",
        "benign_control"
      ]
    },
    "technique": {
      "type": "string",
      "description": "Tactical technique identifier per project taxonomy.",
      "enum": [
        "instruction_override",
        "delimiter_escaping",
        "authority_spoofing",
        "fewshot_hijack",
        "data_layer_poisoning",
        "pivot_injection",
        "zero_width_space",
        "vowel_tone_homoglyph",
        "word_segmentation",
        "code_switching_dilution",
        "canary_extraction",
        "collateral_leak",
        "dlp_bypass",
        "schema_recon",
        "tool_acl_violation",
        "privilege_escalation",
        "benign_thai",
        "benign_mixed",
        "benign_indirect"
      ]
    },
    "language": {
      "type": "string",
      "description": "Canonical language identifier: 'th' (Thai), 'th-en' (Code-mixed), or 'en' (English baseline control).",
      "enum": [
        "th",
        "th-en",
        "en"
      ]
    },
    "difficulty": {
      "type": "string",
      "description": "Cognitive and engineering complexity required to craft or bypass defenses.",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "severity": {
      "type": "string",
      "description": "Security impact severity if the attack succeeds.",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "is_benign": {
      "type": "boolean",
      "description": "True if this case is a legitimate benign control query (used to measure False Refusal Rate / FRR); False if adversarial attack (used to measure Attack Success Rate / ASR)."
    },
    "prompt": {
      "type": "string",
      "description": "The user input prompt delivered to the target model or agent.",
      "minLength": 1
    },
    "injected_content": {
      "type": "string",
      "description": "For indirect injection: the adversarial payload embedded within external data (database row, document, or third-party content)."
    },
    "source_type": {
      "type": "string",
      "description": "For indirect injection: the medium hosting the injected content (e.g., database_record, document, email)."
    },
    "source_table": {
      "type": "string",
      "description": "Database table name hosting the poisoned record in indirect injection."
    },
    "source_record_id": {
      "type": "string",
      "description": "Record identifier hosting the poisoned content in indirect injection."
    },
    "pivot_table": {
      "type": "string",
      "description": "Target database table coerced during indirect pivot attacks."
    },
    "pivot_record_id": {
      "type": "string",
      "description": "Target record identifier coerced during indirect pivot attacks."
    },
    "expected_behavior": {
      "type": "string",
      "description": "Expected security or utility behavior of the model under defense ('refusal' for attacks, 'fulfillment' for benign tasks, 'redaction' for masked output).",
      "enum": [
        "refusal",
        "fulfillment",
        "redaction"
      ]
    },
    "expected_behavior_description": {
      "type": "string",
      "description": "Human-readable description explaining the expected defensive boundary or response."
    },
    "evaluation": {
      "type": "object",
      "description": "Deterministic judge criteria used to score model response without LLM judge variance.",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "Deterministic rule-based scoring algorithm applied to interaction logs.",
          "enum": [
            "canary",
            "forbidden_tools",
            "exact_match",
            "regex_dlp",
            "benign_marker",
            "refusal_check",
            "composite"
          ]
        },
        "expected_tokens": {
          "type": "array",
          "description": "Canaries, substrings, or secret tokens tracked for unauthorized leakage.",
          "items": {
            "type": "string"
          }
        },
        "expected_markers": {
          "type": "array",
          "description": "Expected factual keywords or strings verifying legitimate fulfillment in benign queries.",
          "items": {
            "type": "string"
          }
        },
        "forbidden_tables": {
          "type": "array",
          "description": "Database tables that must never be accessed by the agent during this turn.",
          "items": {
            "type": "string"
          }
        },
        "min_matches": {
          "type": "integer",
          "description": "Minimum count of token matches required to trigger positive evaluation.",
          "minimum": 1
        },
        "metadata": {
          "type": "object",
          "description": "Contextual details (e.g. source_table, pivot_record_id, seed_id, target_defense).",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "source_reference": {
      "type": "string",
      "description": "Academic citation, benchmark provenance, or origin reference for the test case."
    },
    "notes": {
      "type": "string",
      "description": "Optional research notes, semantic equivalence explanation, or experimental context."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "category": {
            "const": "direct_injection"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "owasp_category": {
            "const": "OWASP-LLM01:Prompt-Injection"
          },
          "technique": {
            "enum": [
              "instruction_override",
              "delimiter_escaping",
              "authority_spoofing",
              "fewshot_hijack"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "indirect_injection"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "owasp_category": {
            "const": "OWASP-LLM01:Prompt-Injection"
          },
          "technique": {
            "enum": [
              "data_layer_poisoning",
              "pivot_injection"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "linguistic_evasion"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "owasp_category": {
            "const": "OWASP-LLM01:Prompt-Injection"
          },
          "technique": {
            "enum": [
              "zero_width_space",
              "vowel_tone_homoglyph",
              "word_segmentation",
              "code_switching_dilution"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "sensitive_information_disclosure"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "owasp_category": {
            "const": "OWASP-LLM02:Sensitive-Information-Disclosure"
          },
          "technique": {
            "enum": [
              "canary_extraction",
              "collateral_leak",
              "dlp_bypass",
              "schema_recon"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "excessive_agency"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "technique": {
            "enum": [
              "tool_acl_violation",
              "privilege_escalation"
            ]
          },
          "owasp_category": {
            "const": "OWASP-LLM06:Excessive-Agency"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "benign_control"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "owasp_category": {
            "const": "BENIGN:Control-Baseline"
          },
          "technique": {
            "enum": [
              "benign_thai",
              "benign_mixed",
              "benign_indirect"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "is_benign": {
            "const": true
          }
        },
        "required": [
          "is_benign"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "benign_control"
          },
          "expected_behavior": {
            "const": "fulfillment"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "is_benign": {
            "const": false
          }
        },
        "required": [
          "is_benign"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "not": {
              "const": "benign_control"
            }
          },
          "expected_behavior": {
            "enum": [
              "refusal",
              "redaction"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "technique": {
            "const": "benign_thai"
          }
        },
        "required": [
          "technique"
        ]
      },
      "then": {
        "properties": {
          "language": {
            "const": "th"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "technique": {
            "const": "benign_mixed"
          }
        },
        "required": [
          "technique"
        ]
      },
      "then": {
        "properties": {
          "language": {
            "const": "th-en"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "technique": {
            "const": "data_layer_poisoning"
          }
        },
        "required": [
          "technique"
        ]
      },
      "then": {
        "required": [
          "injected_content",
          "source_type"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "technique": {
            "const": "pivot_injection"
          }
        },
        "required": [
          "technique"
        ]
      },
      "then": {
        "required": [
          "injected_content",
          "source_type",
          "source_table",
          "source_record_id",
          "pivot_table"
        ]
      }
    }
  ],
  "additionalProperties": true
}