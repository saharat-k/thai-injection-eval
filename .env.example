# ==============================================================================
# thai-injection-eval Environment Configuration
# ==============================================================================

# 1. Google Gemini API Key (Required for Blue Assistant & Gemini models)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 2. OpenRouter API Key (Optional for OpenRouter Red Team models like MiniMax, Qwen, DeepSeek)
# Get your free API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 3. Model Configuration
# Format: "model" (Gemini) or "provider:model" (openrouter, github, groq)
# Strict 100% Free-Tier examples:
#   RED_MODEL=openrouter:openrouter/free
#   RED_MODEL=gemini-3.5-flash-lite
RED_MODEL=openrouter:openrouter/free

# Target Blue Team Assistant model (defaults to gemini-3.5-flash-lite)
BLUE_MODEL=gemini-3.5-flash-lite
